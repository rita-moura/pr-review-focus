{
  "manifest_version": 3,
  "name": "GitHub PR Code Only",
  "version": "0.2.2",
  "description": "Mostra somente alterações de arquivos de código em Pull Requests do GitHub.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "rules.js",
        "dom.js",
        "patch.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://patch-diff.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
