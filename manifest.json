{
  "manifest_version": 3,
  "name": "GitHub PR Code Only",
  "version": "0.2.0",
  "description": "Mostra somente alterações de arquivos de código em Pull Requests do GitHub.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "rules.js",
        "dom.js",
        "patch.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
