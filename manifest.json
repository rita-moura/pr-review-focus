{
  "manifest_version": 3,
  "name": "PR Review Focus",
  "version": "0.8.0",
  "description": "Alterna o foco em alterações de código nos Pull Requests do GitHub.",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "Alternar foco da revisão"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "rules.js",
        "dom.js",
        "diff.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
